{
  "name": "express-typescript-backend",
  "version": "1.0.0",
  "description": "Express.js backend with TypeScript and MongoDB Atlas",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "jest",
    "start": "node dist/server.js",
    "create-admin": "ts-node src/scripts/createAdmin.ts",
    "seed-vehicles": "ts-node src/scripts/seedVehicles.ts",
    "migrate-vehicles": "ts-node src/scripts/migrateVehicleModel.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "face-api.js": "^0.22.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "fast-check": "^4.6.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
