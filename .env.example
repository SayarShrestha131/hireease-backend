NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# SMTP Configuration for Password Reset Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourapp.com
FRONTEND_URL=http://localhost:3000

# Payment Gateway Configuration
# Payment Mode: 'sandbox' for testing, 'production' for live payments
PAYMENT_MODE=sandbox

# Khalti Payment Gateway
# Enable/disable Khalti payment gateway
KHALTI_ENABLED=false
# Khalti Public Key (for frontend integration)
KHALTI_PUBLIC_KEY=your-khalti-public-key
# Khalti Secret Key (for backend API calls)
KHALTI_SECRET_KEY=your-khalti-secret-key
# Khalti Webhook Secret (for webhook signature verification)
KHALTI_WEBHOOK_SECRET=your-khalti-webhook-secret

# Stripe Payment Gateway
# Enable/disable Stripe payment gateway
STRIPE_ENABLED=false
# Stripe Publishable Key (for frontend integration)
# Use test key (pk_test_...) for sandbox, live key (pk_live_...) for production
STRIPE_PUBLIC_KEY=your-stripe-publishable-key
# Stripe Secret Key (for backend API calls)
# Use test key (sk_test_...) for sandbox, live key (sk_live_...) for production
STRIPE_SECRET_KEY=your-stripe-secret-key
# Stripe Webhook Signing Secret (for webhook signature verification)
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# PayPal Payment Gateway
# Enable/disable PayPal payment gateway
PAYPAL_ENABLED=false
# PayPal Client ID
# Use sandbox client ID for testing, live client ID for production
PAYPAL_CLIENT_ID=your-paypal-client-id
# PayPal Client Secret
# Use sandbox secret for testing, live secret for production
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PayPal Webhook ID (for webhook verification)
# Get this from PayPal Developer Dashboard > Webhooks
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Receipt Configuration
# Path where PDF receipts will be stored
RECEIPT_STORAGE_PATH=./receipts

# Payment Rate Limiting
# Maximum payment attempts per user per hour
PAYMENT_RATE_LIMIT_PER_HOUR=10

# Security Configuration
# Encryption Master Key for AES-256 encryption of payment credentials
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICAL: Keep this secret secure! Store in secure key management service in production.
# Leave empty in development (will use temporary key with warning)
ENCRYPTION_MASTER_KEY=

# HTTPS Enforcement (recommended for production)
# Set to 'true' to enforce HTTPS for all requests
FORCE_HTTPS=false
